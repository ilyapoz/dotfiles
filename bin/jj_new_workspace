#!/usr/bin/env zsh
#
# jj_new_workspace <revisions>...
#
# Creates a throwaway jj workspace under $JJ_WORKSPACES_DIR (default
# /workspaces) with a new change on top of <revisions>, and drops you into a
# shell there. Leaving the shell snapshots the working copy into that change
# and then removes the workspace and its files; the change survives in the
# repo.

set -euo pipefail

prog=${0:t}

if (( $# == 0 )); then
  print -u2 "usage: $prog <revisions>..."
  exit 2
fi

workspaces_dir=${JJ_WORKSPACES_DIR:-/workspaces}

# A short random name is plenty; `mkdir` (no -p) claims it atomically, so a
# concurrent run that picked the same one loses the race and retries.
name=
for _ in {1..10}; do
  candidate=$(od -An -tx1 -N3 /dev/urandom | tr -d ' \n')
  if mkdir -- "$workspaces_dir/$candidate"; then
    name=$candidate
    break
  fi
  # Only a name collision is worth retrying; a missing parent directory or
  # missing permission would fail identically every time, and mkdir has
  # already reported it.
  [[ -e $workspaces_dir/$candidate ]] || exit 1
done
if [[ -z $name ]]; then
  print -u2 "$prog: could not claim a free workspace name in $workspaces_dir"
  exit 1
fi
dir=$workspaces_dir/$name

# Until the workspace exists, the only thing to undo is the claimed directory.
trap 'rmdir -- "$dir" 2>/dev/null || true' EXIT

# Repo-level operations go through the workspace we were invoked from, so
# cleanup keeps working after the new workspace's files are gone.
main_root=$(jj workspace root)

cleanup() {
  # Nothing may be deleted until the working copy is safely in the change.
  if ! jj -R "$dir" util snapshot; then
    print -u2 "$prog: failed to snapshot $dir, keeping the workspace"
    exit 1
  fi
  if ! jj -R "$main_root" workspace forget -- "$name"; then
    print -u2 "$prog: failed to forget workspace $name, keeping $dir"
    exit 1
  fi
  rm -rf -- "$dir"
  print -u2 "$prog: removed workspace $name ($dir)"
}

jj workspace add -r "$@" -- "$dir"
trap cleanup EXIT INT TERM HUP

# The rc files overwrite PROMPT, but leave RPS1 alone, so the marker goes there.
print -u2 "$prog: entering $dir (exit the shell to discard it)"
cd -- "$dir"
JJ_NEW_WORKSPACE=$name RPS1="%F{yellow}[jj:$name]%f" zsh -i || true
